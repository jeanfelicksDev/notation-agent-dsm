generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id           String        @id @default(uuid())
  nom          String        @unique
  ville        String?
  createdAt    DateTime      @default(now())
  utilisateurs Utilisateur[]
}

model Utilisateur {
  id                  String        @id @default(uuid())
  matricule           String        @unique
  nom                 String
  prenom              String
  email               String        @unique
  telephone           String?
  motDePasse          String
  role                Role          @default(UTILISATEUR)
  sexe                String?
  nationalite         String?
  emploi              String?
  service             String?
  departement         String?
  direction           String?
  siteId              String?
  qrcodeActif         Boolean       @default(false)
  qrToken             String?       @unique
  tentativesEchouees  Int           @default(0)
  verrouilleJusqua    DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  affectationsRecues  Affectation[] @relation("EvalueAffectations")
  affectationsDonnees Affectation[] @relation("EvaluateurAffectations")
  evaluationsRecues   Note[]        @relation("NoteRecue")
  evaluationsDonnees  Note[]        @relation("NoteDonnee")
  notesClients        NoteClient[]
  scores              ScoreFinal[]
  otpTokens           OtpToken[]
  sessions            Session[]
  site                Site?         @relation(fields: [siteId], references: [id])

  @@index([role])
  @@index([siteId])
  @@index([qrcodeActif])
}

model OtpToken {
  id            String      @id @default(uuid())
  utilisateurId String
  codeHash      String
  expiresAt     DateTime
  attempts      Int         @default(0)
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
}

model Session {
  id            String      @id @default(uuid())
  token         String      @unique
  utilisateurId String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  userAgent     String?
  ipAddress     String?
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([expiresAt])
}

model Campagne {
  id             String         @id @default(uuid())
  libelle        String
  dateDebut      DateTime
  dateFin        DateTime
  statut         StatutCampagne @default(OUVERTE)
  poidsCollegues Int            @default(45)
  poidsManager   Int            @default(55)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  affectations   Affectation[]
  criteres       Critere[]
  notes          Note[]
  notesClients   NoteClient[]
  scores          ScoreFinal[]
  poidsClient     Int            @default(25)
  prixDirection   String?        @default("Trophée d'Excellence + Dotation Spéciale")
  prixDepartement String?        @default("Certificat de Mérite + Prime")
  prixService     String?        @default("Diplôme d'Honneur + Prime")
  prixGlobal      String?        @default("Super Lauréat DSM 360°")

  @@index([statut])
}

model Critere {
  id             String   @id @default(uuid())
  libelle        String
  description    String?
  noteMaximale   Int      @default(5)
  typeEvaluateur  TypeEval @default(COLLEGUE)
  typeEvaluateurs TypeEval[] @default([])
  campagneId     String
  createdAt      DateTime @default(now())
  campagne       Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  notes          Note[]
  notesClients   NoteClient[]

  @@index([campagneId])
}

model Affectation {
  id           String            @id @default(uuid())
  evaluateurId String
  evalueId     String
  campagneId   String
  statut       StatutAffectation @default(EN_ATTENTE)
  /// Pair désigné « client interne » de ce collaborateur : il note les critères CLIENT_INTERNE
  clientInterne Boolean          @default(false)
  createdAt    DateTime          @default(now())
  campagne     Campagne          @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  evalue       Utilisateur       @relation("EvalueAffectations", fields: [evalueId], references: [id], onDelete: Cascade)
  evaluateur   Utilisateur       @relation("EvaluateurAffectations", fields: [evaluateurId], references: [id], onDelete: Cascade)

  @@unique([evaluateurId, evalueId, campagneId])
  @@index([evaluateurId, campagneId])
  @@index([evalueId, campagneId])
  @@index([campagneId, statut])
}

model Note {
  id           String      @id @default(uuid())
  valeur       Int
  commentaire  String?
  evaluateurId String
  evalueId     String
  critereId    String
  campagneId   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  campagne     Campagne    @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  critere      Critere     @relation(fields: [critereId], references: [id], onDelete: Cascade)
  evalue       Utilisateur @relation("NoteRecue", fields: [evalueId], references: [id], onDelete: Cascade)
  evaluateur   Utilisateur @relation("NoteDonnee", fields: [evaluateurId], references: [id], onDelete: Cascade)

  @@unique([evaluateurId, evalueId, critereId, campagneId])
  @@index([campagneId])
  @@index([evaluateurId, evalueId, campagneId])
  @@index([evalueId, campagneId])
  @@index([critereId])
}

model NoteClient {
  id          String      @id @default(uuid())
  agentId     String
  campagneId  String
  critereId   String
  valeur      Int
  commentaire String?
  ipHash      String?
  clientId    String?
  createdAt   DateTime    @default(now())
  agent       Utilisateur @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campagne    Campagne    @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  critere     Critere     @relation(fields: [critereId], references: [id], onDelete: Cascade)

  @@index([agentId, campagneId])
  @@index([ipHash, agentId, campagneId])
  @@index([clientId, agentId, campagneId])
}

model ScoreFinal {
  id             String      @id @default(uuid())
  utilisateurId  String
  campagneId     String
  scoreCollegues Float       @default(0)
  scoreManager   Float       @default(0)
  scoreClient    Float       @default(0)
  scoreTotal     Float       @default(0)
  rang           Int?
  createdAt      DateTime    @default(now())
  campagne       Campagne    @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, campagneId])
  @@index([campagneId, scoreTotal(sort: Desc)])
}

enum StatutCampagne {
  OUVERTE
  CLOTUREE
  CALCULEE
}

enum TypeEval {
  MANAGER
  COLLEGUE
  TOUS
  CLIENT
  CLIENT_INTERNE
}

enum StatutAffectation {
  EN_ATTENTE
  BROUILLON
  TERMINEE
}

enum Role {
  ADMIN
  MANAGER
  UTILISATEUR
  EXTERNE
}
